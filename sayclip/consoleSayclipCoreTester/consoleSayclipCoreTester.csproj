<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>consoleSayclipCoreTester</RootNamespace>
    <AssemblyName>consoleSayclipCoreTester</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="5.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\logSystem\logSystem.csproj" />
    <ProjectReference Include="..\sayclip\sayclip.csproj" />
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <Exec Command="xcopy /s /e /y &quot;$(ProjectDir)..\sayclip\plugins&quot; &quot;$(ProjectDir)$(OutDir)plugins&quot;" Condition="'$(OS)' == 'Windows_NT'" />
  </Target>

</Project>