<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="window.title">OpenRouter Plugin - Configuracion</sys:String>
    <sys:String x:Key="section.connection">Conexion</sys:String>
    <sys:String x:Key="label.apiKey">API Key:</sys:String>
    <sys:String x:Key="label.apiKey.hint">Introduce tu API key de OpenRouter. Puedes obtener una en https://openrouter.ai/keys</sys:String>
    <sys:String x:Key="label.model">Modelo:</sys:String>
    <sys:String x:Key="label.model.hint">Identificador de modelo de OpenRouter, ej: openai/gpt-4o-mini o anthropic/claude-3.5-haiku</sys:String>
    <sys:String x:Key="section.behavior">Comportamiento</sys:String>
    <sys:String x:Key="label.temperature">Temperatura (0.0 - 1.0):</sys:String>
    <sys:String x:Key="label.temperature.hint">Valores mas bajos producen traducciones mas consistentes. Recomendado: 0.0</sys:String>
    <sys:String x:Key="label.maxTokens">Tokens maximos:</sys:String>
    <sys:String x:Key="label.maxTokens.hint">Numero maximo de tokens en la respuesta. Aumenta para textos largos.</sys:String>
    <sys:String x:Key="label.timeout">Tiempo de espera (segundos):</sys:String>
    <sys:String x:Key="label.timeout.hint">Tiempo maximo de espera para la respuesta de la API antes de cancelar.</sys:String>
    <sys:String x:Key="section.prompt">Prompt del sistema</sys:String>
    <sys:String x:Key="label.systemPrompt">Prompt del sistema que se envia al modelo antes de cada solicitud de traduccion:</sys:String>
    <sys:String x:Key="button.save">Guardar</sys:String>
    <sys:String x:Key="button.cancel">Cancelar</sys:String>
    <sys:String x:Key="button.testConnection">Probar conexion</sys:String>
    <sys:String x:Key="link.getApiKey">Obtener tu API key en openrouter.ai</sys:String>
    <sys:String x:Key="link.getApiKey.automationName">Abrir documentacion para obtener API key de OpenRouter</sys:String>
    <sys:String x:Key="link.getApiKey.automationHelp">Abre la pagina de OpenRouter con instrucciones para crear una API key.</sys:String>
    <sys:String x:Key="msg.testOk">Conexion exitosa. El plugin esta listo para usar.</sys:String>
    <sys:String x:Key="msg.testFail">Fallo la conexion. Revisa tu API key y conexion a internet. Consulta los logs para mas detalles.</sys:String>
    <sys:String x:Key="msg.noApiKey">Por favor ingresa una API key antes de probar.</sys:String>
    <sys:String x:Key="msg.invalidTemperature">La temperatura debe ser un numero entre 0.0 y 1.0.</sys:String>
    <sys:String x:Key="msg.invalidMaxTokens">Los tokens maximos deben ser un entero positivo.</sys:String>
    <sys:String x:Key="msg.invalidTimeout">El tiempo de espera debe ser un entero positivo (segundos).</sys:String>

</ResourceDictionary>
